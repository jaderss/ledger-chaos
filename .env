JAVA_VERSION=25
GO_VERSION=1.27
POSTGRES_VERSION=18.6
KAFKA_VERSION=4.4.0
TOXIPROXY_VERSION=2.13.0
FLYWAY_VERSION=12.4.0
NODE_VERSION=26
NGINX_VERSION=1.31
REPORT_PORT=8090

POSTGRES_PASSWORD=postgres
LEDGER_DB_PASSWORD=ledger
RELAY_DB_PASSWORD=relay
PROJECTOR_DB_PASSWORD=projector

APP_CPUS=2
APP_MEMORY_MB=1536
HEAP_PERCENT=75
JVM_GC=ParallelGC

LEDGER_MODE=correct
LEDGER_LOCKING=ordered
SERIALIZABLE_RETRIES=5
STATEMENT_TIMEOUT=2s
DB_SOCKET_TIMEOUT_S=5
POOL_SIZE=20

RELAY_BATCH=100
RELAY_INTERVAL=50ms
IDLE_IN_TX_TIMEOUT=10s
KAFKA_DELIVERY_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=3000
KAFKA_MAX_BLOCK_MS=3000
TOPIC_PARTITIONS=6
PROJECTOR_CONCURRENCY=3
KAFKA_SESSION_TIMEOUT_MS=10000

ACCOUNTS=20
WORKERS=64
READERS=4
DURATION=120s
CLIENT_TIMEOUT=1s
RETRIES=5
DUPLICATE_RATE=0.05
MISMATCH_RATE=0.01
FAULT_INTERVAL=10s
FAULT_DURATION=3s
QUIET_TIMEOUT=60s
FUNDING_MINOR=100000
AMOUNT_MAX_MINOR=5000
OVERDRAFT_EVERY=10
DB_LATENCY=1500ms
SEED=
